# Project Artha — environment variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it is already in .gitignore.

# ─── Supabase (AR-1: Postgres migration) ──────────────────────────────────────
# Get these from: Supabase dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your-anon-key-here

# ─── GitHub Actions secrets (set in repo settings, not in .env) ───────────────
# RESEND_API_KEY       — for daily email alerts (scripts/alert.py)
# ALERT_EMAIL          — recipient email for daily alerts
# SUPABASE_SERVICE_KEY — for writing signal_history rows from GH Actions (AR-3)
#                        Service role key — bypasses RLS. NEVER expose in frontend.
